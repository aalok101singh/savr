# Savr environment template.
# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.

# ── AWS (live mode only) ──────────────────────────────────────────
# Required solely for "live" runs against Amazon Bedrock.
# Real values live in your local .env; if these were ever pushed/shared,
# rotate them immediately in the AWS console.
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# ── Demo mode ─────────────────────────────────────────────────────
# true  → deterministic offline demo (LocalModel, cached evidence, zero cost)
# false → real Bedrock calls (needs AWS credentials + least-privilege IAM)
DEMO_MODE=true

# ── Model ─────────────────────────────────────────────────────────
# Optional dev/test override. "local" forces the deterministic LocalModel on
# the live path; any other value overrides the pinned Bedrock model ID.
#SAVR_MODEL=

# ── Autopilot (background Guardian loop) ──────────────────────────
# Off by default so a dev server never makes unsolicited Bedrock calls.
# Set to "true" to run autonomous checks on an interval (default 120s).
AUTOPILOT_ENABLED=false
#AUTOPILOT_INTERVAL_MS=120000

# ── Optional live web evidence (9Router-compatible gateway) ───────
# When set, benchmark_pricing / search_alternatives can enrich beyond the
# cached evidence; otherwise they degrade honestly to evidence_unavailable.
#NINEROUTER_URL=

# ── API ───────────────────────────────────────────────────────────
#API_PORT=3000
# HOST default 127.0.0.1 (loopback). Any deployment exposing the API beyond
# loopback (Docker/ECS/VM) MUST set HOST AND API_TOKEN, or every POST /api/*
# and debug route is refused.
#HOST=127.0.0.1
#API_TOKEN=
# DEBUG_MODE=true registers the /api/debug/negotiation/* routes (dev only).
#DEBUG_MODE=false
#SANDBOX_PORT=3001